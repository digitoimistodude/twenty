[Unit]
Description=Twenty to Slack #myynti webhook relay
After=network.target

[Service]
Type=simple
User=rolle
WorkingDirectory=/home/rolle/twenty-slack-relay
ExecStart=/home/rolle/.nvm/versions/node/v24.17.0/bin/node --env-file=/home/rolle/twenty-slack-relay/.env /home/rolle/twenty-slack-relay/server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
